# Copiar a .env y completar con valores propios (el archivo .env NO se versiona).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/flowinsight
# Generar una clave aleatoria, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Recuperacion de contrasena por SMS.
# "consola" (por defecto): el codigo solo aparece en el log del servidor; ideal para desarrollo.
# "twilio": envia SMS reales; requiere una cuenta de Twilio y las tres variables siguientes.
SMS_PROVIDER=consola
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Correo saliente (recuperacion de contrasena si no hay SMS, vista previa de promociones).
# "consola" (por defecto): el mensaje solo aparece en el log del servidor.
# "resend": API HTTPS de Resend (recomendado en Railway, que suele bloquear SMTP). Requiere RESEND_API_KEY y
#           un dominio verificado en Resend (registros SPF/DKIM) para que los correos no lleguen a spam.
# "smtp": servidor SMTP propio (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD).
EMAIL_PROVIDER=consola
RESEND_API_KEY=
EMAIL_FROM=FlowInsight <no-reply@su-dominio.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Datos de la empresa para los mensajes de promocion. Sin WHATSAPP/PEDIDO_URL no aparecen los botones.
EMPRESA_NOMBRE=W&T Food S.A.S.
EMPRESA_WHATSAPP=
EMPRESA_PEDIDO_URL=
# Enviar promociones al correo de los clientes (solo los que autorizaron el uso de sus datos). Apagado por defecto.
PROMO_ENVIO_REAL=false

# URL del frontend desplegado (para CORS). Varias separadas por coma.
FRONTEND_URL=
