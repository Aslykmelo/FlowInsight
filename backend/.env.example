# Copiar a .env y completar con valores propios (el archivo .env NO se versiona).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/flowinsight
# Generar una clave aleatoria, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Recuperacion de contrasena por SMS.
# "consola" (por defecto): el codigo solo aparece en el log del servidor; ideal para desarrollo.
# "twilio": envia SMS reales; requiere una cuenta de Twilio y las tres variables siguientes.
SMS_PROVIDER=consola
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
